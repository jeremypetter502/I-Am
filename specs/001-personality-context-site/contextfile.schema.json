{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Personal Context (ContextFile) Schema",
  "description": "Versioned schema for exported personal context files (JSON). Supports IPIP, aesthetic, music, extended modules and IAM mappings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "profile"],
  "properties": {
    "preamble": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": { "type": "string" },
        "schema_version": { "type": "string" },
        "scoring_version": { "type": "string" },
        "trait_key_map": { "type": "object", "additionalProperties": { "type": "string" } },
        "normalization": { "type": "string" },
        "provenance": { "type": "object", "additionalProperties": true },
        "privacy": { "type": "object", "additionalProperties": true },
        "usage_snippet": { "type": "string" },
        "machine_readable": { "type": "object", "additionalProperties": true }
      }
    },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$", "description": "Schema version, e.g. 1.0" },
    "generated_at": { "type": "string", "format": "date-time", "description": "UTC timestamp when file was produced" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string" },
        "tool_version": { "type": "string" },
        "session_id": { "type": "string" },
        "locale": { "type": "string" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "scores", "modules"],
      "properties": {
        "id": { "type": "string", "description": "Optional profile identifier (client-assigned)" },
        "summary": { "type": "string", "description": "1-2 sentence natural-language summary, editable by user" },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["extraversion","agreeableness","conscientiousness","neuroticism","openness"],
          "properties": {
            "extraversion": { "type": "number", "minimum": 0, "maximum": 100 },
            "agreeableness": { "type": "number", "minimum": 0, "maximum": 100 },
            "conscientiousness": { "type": "number", "minimum": 0, "maximum": 100 },
            "neuroticism": { "type": "number", "minimum": 0, "maximum": 100 },
            "openness": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "raw_scores": {
          "type": "object",
          "description": "Optional raw/diagnostic scores per trait (e.g., 10..50)",
          "additionalProperties": { "type": "number" }
        },
        "modules": {
          "type": "object",
          "description": "Module-level inputs and computed outputs",
          "properties": {
            "ipip": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "responses": {
                  "type": "array",
                  "items": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "minItems": 50,
                  "maxItems": 50,
                  "description": "IPIP-50 respondent answers in order"
                },
                "raw_trait_scores": {
                  "type": "object",
                  "additionalProperties": { "type": "number" },
                  "description": "Raw trait sums (10..50) mapped by trait name"
                },
                "normalized_trait_scores": {
                  "type": "object",
                  "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 },
                  "description": "Normalized 0..100 trait scores"
                },
                "disabled": { "type": "boolean" },
                "completed": { "type": "boolean" },
                "last_updated": { "type": "string", "format": "date-time" }
              }
            },
            "aesthetics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "minimalism": { "type": "number", "minimum": 0, "maximum": 100 },
                "colorfulness": { "type": "number", "minimum": 0, "maximum": 100 },
                "warmth": { "type": "number", "minimum": 0, "maximum": 100 },
                "texture": { "type": "number", "minimum": 0, "maximum": 100 },
                "motion": { "type": "number", "minimum": 0, "maximum": 100 },
                "imagery": {
                  "type": "object",
                  "properties": {
                    "photos": { "type": "number", "minimum": 0, "maximum": 100 },
                    "illustrations": { "type": "number", "minimum": 0, "maximum": 100 }
                  },
                  "additionalProperties": false
                },
                "typography": {
                  "type": "object",
                  "properties": {
                    "prefers_serif": { "type": "number", "minimum": 0, "maximum": 100 },
                    "prefers_sans": { "type": "number", "minimum": 0, "maximum": 100 },
                    "prefers_large_headings": { "type": "number", "minimum": 0, "maximum": 100 },
                    "prioritize_readability": { "type": "number", "minimum": 0, "maximum": 100 }
                  },
                  "additionalProperties": false
                },
                "layout": {
                  "type": "object",
                  "properties": {
                    "grid_consistency": { "type": "number", "minimum": 0, "maximum": 100 },
                    "experimental_layouts": { "type": "number", "minimum": 0, "maximum": 100 }
                  },
                  "additionalProperties": false
                },
                "disabled": { "type": "boolean" },
                "importance": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            },
            "music": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "factors": {
                  "type": "object",
                  "properties": {
                    "mellow": { "type": "number", "minimum": 0, "maximum": 100 },
                    "sophisticated": { "type": "number", "minimum": 0, "maximum": 100 },
                    "unpretentious": { "type": "number", "minimum": 0, "maximum": 100 },
                    "intense": { "type": "number", "minimum": 0, "maximum": 100 },
                    "contemporary": { "type": "number", "minimum": 0, "maximum": 100 }
                  },
                  "additionalProperties": false
                },
                "disabled": { "type": "boolean" }
              }
            },
            "communication": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "responses": {
                  "type": "array",
                  "items": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "minItems": 20,
                  "maxItems": 20
                },
                "raw_trait_scores": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "driver": { "type": "number", "minimum": 5, "maximum": 25 },
                    "analytical": { "type": "number", "minimum": 5, "maximum": 25 },
                    "expressive": { "type": "number", "minimum": 5, "maximum": 25 },
                    "amiable": { "type": "number", "minimum": 5, "maximum": 25 }
                  }
                },
                "normalized_trait_scores": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "driver": { "type": "number", "minimum": 0, "maximum": 100 },
                    "analytical": { "type": "number", "minimum": 0, "maximum": 100 },
                    "expressive": { "type": "number", "minimum": 0, "maximum": 100 },
                    "amiable": { "type": "number", "minimum": 0, "maximum": 100 }
                  }
                },
                "disabled": { "type": "boolean" },
                "completed": { "type": "boolean" },
                "last_updated": { "type": "string", "format": "date-time" }
              }
            },
            "skills": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "responses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string", "minLength": 1 },
                      "index": { "type": "integer", "minimum": 1, "maximum": 35 },
                      "category": { "type": "string" },
                      "raw_score": { "type": "number", "minimum": 0, "maximum": 5 },
                      "normalized_score": { "type": "number", "minimum": 0, "maximum": 100 },
                      "threshold_status": { "type": "string", "enum": ["results_worthy", "conditional", "omit"] },
                      "listed_status": { "type": "string", "enum": ["confirmed", "conditional", "excluded"] },
                      "test_results": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "interview_defense": { "type": "boolean" },
                          "day_one_autonomy": { "type": "boolean" },
                          "relevance_recency": { "type": "boolean" }
                        }
                      }
                    },
                    "required": ["name", "index", "normalized_score"]
                  }
                },
                "filtered": {
                  "type": "array",
                  "items": { "$ref": "#/properties/profile/properties/modules/properties/skills/properties/responses/items" }
                },
                "normalized": {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0, "maximum": 100 },
                  "maxItems": 35
                },
                "testAnswers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "interview_defense": { "type": "boolean" },
                      "day_one_autonomy": { "type": "boolean" },
                      "relevance_recency": { "type": "boolean" }
                    }
                  }
                },
                "disabled": { "type": "boolean" },
                "completed": { "type": "boolean" },
                "last_updated": { "type": "string", "format": "date-time" }
              }
            },
            "state": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bandwidth": { "type": "number", "minimum": 0, "maximum": 100 },
                "mode": { "type": "string", "enum": ["convergent", "divergent"] },
                "horizon": { "type": "string", "enum": ["now", "long"] },
                "stakes": { "type": "string", "enum": ["critical", "casual"] },
                "disabled": { "type": "boolean" },
                "completed": { "type": "boolean" },
                "last_updated": { "type": "string", "format": "date-time" }
              },
              "required": ["bandwidth", "mode", "horizon", "stakes"]
            },
            "extended": {
              "type": "object",
              "description": "Optional extended modules; schema may vary",
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "tags": {
          "type": "object",
          "description": "Boolean tags to simplify rule-based LLMs",
          "additionalProperties": { "type": "boolean" }
        },
        "preferences": {
          "type": "object",
          "description": "Top-level convenience mapping (mirrors modules.aesthetics)",
          "additionalProperties": true
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "onet": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "soc_code": { "type": "string", "pattern": "^\\d{2}-\\d{4}$" },
                "title": { "type": "string", "minLength": 1 },
                "version": { "type": "string" }
              },
              "required": ["soc_code", "title"]
            },
            "name": { "type": "string", "maxLength": 120 },
            "first_name": { "type": "string", "maxLength": 80 },
            "birth_month": { "type": "integer", "minimum": 1, "maximum": 12 },
            "birth_day": { "type": "integer", "minimum": 1, "maximum": 31 },
            "birth_year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
            "gender": { "type": "string", "maxLength": 60 },
            "culture": { "type": "string", "maxLength": 40 },
            "job_title": { "type": "string", "maxLength": 120 },
            "company": { "type": "string", "maxLength": 120 },
            "skills": { "type": "string", "maxLength": 400 },
            "years_experience": { "type": "number", "minimum": 0, "maximum": 80 },
            "education_level": {
              "type": "string",
              "enum": ["high_school", "associate", "bachelor", "master", "doctorate", "other"]
            },
            "timezone": { "type": "string", "minLength": 1 },
            "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
            "communication_style": { "type": "string", "maxLength": 40 },
            "short_bio": { "type": "string", "maxLength": 280 }
          }
        },
        "iam": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "description": "I-AM compact code string following IAM specification" },
            "version": { "type": "string", "description": "IAM version identifier (optional)" }
          },
          "required": ["code"]
        }
      }
    },
    "raw_responses": {
      "type": "object",
      "description": "Application-only raw input responses intended for client-side state; LLMs should ignore this field.",
      "additionalProperties": true
    }
  }
}
